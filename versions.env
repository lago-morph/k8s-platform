# Pinned tool versions for top-level CI workflows. Each pin is
# referenced both from `.github/workflows/*.yml` (CI install steps)
# and from local-developer install scripts. Bump deliberately; a single
# source of truth keeps CI and local environments in sync.
#
# Separate from `tests/chainsaw/versions.env`, which pins
# cluster-runtime versions (Crossplane chart, provider packages, kind,
# chainsaw) for the chainsaw harness.

# kubeconform — static YAML lint against CRD JSON schemas. Pinned in
# .github/workflows/unit-tests.yml and consumed by
# tests/unit/test_kubeconform_manifests.sh. SPEC-S6.
KUBECONFORM_VERSION="v0.6.7"

# ArgoCD — a PAIRED pin (L31): the helm CHART version deployed by
# terraform/management (variables.tf `argocd_version` — terraform cannot
# source this file, so that default is a deliberate duplicate held equal
# by tests/unit/test_version_pin_consistency.sh) and the ArgoCD APP
# version that chart ships (argo-helm Chart.yaml appVersion; chart 10.20.0
# → v3.6.3). scripts/fetch-crds-for-kubeconform.sh sources this file and
# fetches the argoproj CRD schemas at ARGOCD_APP_VERSION, so the
# kubeconform store always validates against the DEPLOYED ArgoCD — bump
# the pair together (retro 2026-06-10-218: the store sat at v2.13.1
# against a deployed v2.10.4 for its entire life before this pin).
# The app version must be tested upstream on every Kubernetes version we
# deploy (tests/unit/test_argocd_kubernetes_support.sh): 3.6 is the first
# line tested on 1.37; v2.10.4 could not compare Deployments on 1.35+
# (".status.terminatingReplicas: field not declared in schema", kp-2al.56).
# The argocd CLI pin (tests/chainsaw/versions.env ARGOCD_VERSION) equals
# ARGOCD_APP_VERSION — held by test_version_pin_consistency.sh.
ARGOCD_CHART_VERSION="10.20.0"
ARGOCD_APP_VERSION="v3.6.3"

# mkdocs + material — the documentation-site generator (docs/site/,
# published to GitHub Pages). Pinned here as the single source of
# truth, consumed by the pip-install step in
# .github/workflows/docs-site.yml and by local sessions building the
# site the same way:
#   pip install "mkdocs==${MKDOCS_VERSION}" "mkdocs-material==${MKDOCS_MATERIAL_VERSION}"
MKDOCS_VERSION="1.6.1"
MKDOCS_MATERIAL_VERSION="9.7.6"

# beads (bd) and dolt are pinned in .claude/beads/versions.env, written by
# ai-sandbox's repo kit from ai-sandbox's versions.toml (the same bd the
# ai-sandbox host runs: bd refuses a database migrated by a newer bd).
# Bump them there, through ai-sandbox, never here (ai/beads-dolthub.md).
