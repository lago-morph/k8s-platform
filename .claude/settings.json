{
  "env": {
    "BEADS_DOLT_SERVER_MODE": "1",
    "BEADS_DOLT_AUTO_START": "0",
    "BD_NO_REMOTE_ADOPT": "1"
  },
  "permissions": {
    "allow": [
      "mcp__Claude_Code_Remote",
      "mcp__Jentic",
      "mcp__github",
      "Bash(bash .claude/beads/beads.sh:*)",
      "Bash(bash \"$CLAUDE_PROJECT_DIR/.claude/beads/beads.sh\":*)"
    ],
    "deny": [
      "Bash(bd init:*)",
      "Bash(bd bootstrap:*)",
      "Bash(bd sync:*)",
      "Bash(bd dolt start:*)",
      "Bash(bd dolt stop:*)",
      "Bash(bd dolt killall:*)",
      "Bash(bd dolt push:*)",
      "Bash(bd dolt pull:*)",
      "Bash(bd doctor --fix:*)",
      "Bash(bd migrate:*)",
      "Bash(dolt sql-server:*)",
      "Bash(dolt clone:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/beads/beads.sh\" session-start",
            "timeout": 600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__execute",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/pre-chainsaw-audit-hook.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/beads/beads.sh\" prepush-hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(.transcript_path)\\t\\(.session_id)\"' | { IFS=$'\\t' read -r src sid; if [ -n \"$src\" ] && [ -n \"$sid\" ] && [ -f \"$src\" ]; then cp \"$src\" \"$CLAUDE_PROJECT_DIR/logs/$sid.jsonl\"; fi; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/beads/beads.sh\" status"
          }
        ]
      }
    ]
  }
}
