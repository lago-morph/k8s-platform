.claude/settings.local.json
.claude/worktrees/

# Python cache from importing .github/scripts/post-comment.py in unit
# tests (tests/unit/test_post_comment.sh). Never useful to commit.
__pycache__/
*.pyc
*.pyo

# Terraform local state — backends are S3-backed; nothing local
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# mkdocs build output (docs-site.yml builds and publishes; never commit)
/site/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
